# ==============================================================================
# AI Cloud Hosting - Backend Environment Configuration Template
# ==============================================================================

# Server Port (default: 8080)
PORT=8080

# Primary PostgreSQL Database Connection URL (required)
DB_URL=host=localhost user=postgres password=postgres dbname=ai_cloud_db port=5432 sslmode=disable

# Google Gemini API Key for Auto-Dockerfile and Monorepo architecture generation
GEMINI_API_KEY=your_gemini_api_key_here

# Docker Host Socket (Unix socket on macOS/Linux, or TCP on Windows/Docker Desktop)
# macOS default: unix:///var/run/docker.sock or unix://$HOME/.docker/run/docker.sock
# Linux default: unix:///var/run/docker.sock
DOCKER_HOST=unix:///var/run/docker.sock

# JWT Secret for Authentication Token Signing
JWT_SECRET=ai-cloud-hosting-super-secret-production-jwt-key-2026

# Platform Host & Domain Configuration
PLATFORM_DOMAIN=localhost
PUBLIC_HOST=localhost
PUBLIC_API_URL=http://localhost:8080/api
FRONTEND_URL=http://localhost:5173

# CORS Configuration (comma-separated allowed origins or '*')
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Webhook Alerting Brand Customization
ACH_BRAND_NAME="AI Cloud Hosting"
ACH_BRAND_ICON_URL="https://img.icons8.com/color/96/cloud.png"
